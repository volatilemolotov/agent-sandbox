"""
End-to-end test for the nullclaw-sandbox example.

Creates a kind cluster, deploys the agent-sandbox controller, then hands off
to the example's own run-test-kind.sh, which pulls/loads the nullclaw image,
applies the config and sandbox manifests, and checks the gateway's /health
endpoint through a port-forward.
"""

import os
import subprocess
import sys

_repo_root = os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__)))))
if _repo_root not in sys.path:
    sys.path.insert(0, _repo_root)

from dev.ci.shared.runner import TestRunner

EXAMPLE_DIR = os.path.join(_repo_root, "examples", "nullclaw-sandbox")


class NullclawSandboxTestRunner(TestRunner):
    def __init__(self):
        # run-test-kind.sh unconditionally does `export KIND_CLUSTER_NAME=
        # "agent-sandbox"` at the top, clobbering whatever's already in the
        # environment -- so self.name (the actual kind cluster name TestRunner
        # creates) has to match that hardcoded value, not describe this job.
        super().__init__("agent-sandbox", "e2e test for the nullclaw-sandbox example")

    def setup_cluster(self, args):
        # run-test-kind.sh pulls/loads the nullclaw image itself; cluster
        # bring-up only needs the controller image for the k8s/ manifests
        # deploy-to-kube applies, not every example in the repo.
        return super().setup_cluster(args, extra_push_images_args=["--images", "agent-sandbox-controller"])

    def run_tests(self, args):
        env = os.environ.copy()
        env["KUBECONFIG"] = os.path.join(self.repo_root, "bin", "KUBECONFIG")
        # Harmless belt-and-suspenders: run-test-kind.sh currently clobbers
        # this with its own hardcoded "agent-sandbox" anyway (see __init__),
        # but sets it here too in case that ever changes to respect an
        # existing value.
        env["KIND_CLUSTER_NAME"] = self.name

        print("=== nullclaw-sandbox e2e test ===")
        result = subprocess.run(
            ["bash", os.path.join(EXAMPLE_DIR, "run-test-kind.sh")],
            cwd=EXAMPLE_DIR, env=env,
        )

        if result.returncode != 0:
            print("ERROR: run-test-kind.sh failed.", file=sys.stderr)
            subprocess.run(
                ["kubectl", "logs", "-l", "sandbox=nullclaw-sandbox", "--tail=50"],
                env=env, check=False,
            )
            subprocess.run(
                ["kubectl", "describe", "pod", "-l", "sandbox=nullclaw-sandbox"],
                env=env, check=False,
            )

        return result


if __name__ == "__main__":
    runner = NullclawSandboxTestRunner()
    runner.main()
