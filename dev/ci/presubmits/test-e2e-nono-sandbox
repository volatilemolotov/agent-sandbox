"""
End-to-end test for the nono-sandbox example.

Creates a kind cluster, deploys the agent-sandbox controller, then hands off
to the example's own run-test-kind.sh, which builds the demo image, spins up
a TLS-secured Loki plus an ephemeral signed-audit identity, applies the
Sandbox, asserts nono enforced its filesystem/credential/network/tool
boundaries from the workload's log output, then finalizes and cryptographically
verifies the signed audit session.

Note: nono fails closed on filesystem controls if the node kernel lacks
Landlock (Linux >= 5.13 with landlock in the active LSM stack) -- the script
detects this and exits with a clear message rather than a confusing
assertion failure, but the presubmit will still fail on a kernel without it.
This is a real, not-yet-confirmed risk for standard kind-in-docker CI nodes,
analogous to openclaw-gvisor-sandbox needing a gvisor RuntimeClass.
"""

import os
import subprocess
import sys

_repo_root = os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__)))))
if _repo_root not in sys.path:
    sys.path.insert(0, _repo_root)

from dev.ci.shared.runner import TestRunner

EXAMPLE_DIR = os.path.join(_repo_root, "examples", "nono-sandbox")


class NonoSandboxTestRunner(TestRunner):
    def __init__(self):
        super().__init__("nono-sandbox-test", "e2e test for the nono-sandbox example")

    def setup_cluster(self, args):
        # run-test-kind.sh builds and kind-loads the demo image itself;
        # cluster bring-up only needs the controller image for the k8s/
        # manifests deploy-to-kube applies, not every example in the repo.
        return super().setup_cluster(args, extra_push_images_args=["--images", "agent-sandbox-controller"])

    def run_tests(self, args):
        env = os.environ.copy()
        env["KUBECONFIG"] = os.path.join(self.repo_root, "bin", "KUBECONFIG")
        # run-test-kind.sh reads KIND_CLUSTER_NAME with a "${VAR:-agent-sandbox}"
        # default (not an unconditional export like nullclaw-sandbox's script),
        # so setting it here to the actual cluster name TestRunner created is
        # respected rather than clobbered.
        env["KIND_CLUSTER_NAME"] = self.name

        print("=== nono-sandbox e2e test ===")
        result = subprocess.run(
            ["bash", os.path.join(EXAMPLE_DIR, "run-test-kind.sh")],
            cwd=EXAMPLE_DIR, env=env,
        )

        if result.returncode != 0:
            print("ERROR: run-test-kind.sh failed.", file=sys.stderr)
            subprocess.run(
                ["kubectl", "logs", "-l", "sandbox=nono-agent", "--tail=80"],
                env=env, check=False,
            )
            subprocess.run(
                ["kubectl", "describe", "pod", "-l", "sandbox=nono-agent"],
                env=env, check=False,
            )

        return result


if __name__ == "__main__":
    runner = NonoSandboxTestRunner()
    runner.main()
