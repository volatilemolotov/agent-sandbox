"""PoC periodic job: proves the CI -> GitHub-issue pipeline works end to end.

Runs identically from Prow (periodic-agent-sandbox-poc-github-issue) and from
GitHub Actions (.github/workflows/poc-github-issue.yml). Every run, it files
(or comments on) a single shared tracking issue, using only the standard
library so this job needs no extra pip dependencies. Delete this script and
both its CI job configs once the pipeline (periodic job -> github token ->
GitHub API) has been verified to work.
"""

import json
import os
import sys
import urllib.parse
import urllib.request

API_ROOT = "https://api.github.com"
TOKEN_PATH = "/etc/github-token/token"
REPO = "kubernetes-sigs/agent-sandbox"
MARKER = "<!-- poc-periodic-github-issue -->"


def _request(method, url, token, body=None):
    data = json.dumps(body).encode("utf-8") if body is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Authorization", f"Bearer {token}")
    req.add_header("Accept", "application/vnd.github+json")
    req.add_header("User-Agent", "agent-sandbox-poc-github-issue")
    with urllib.request.urlopen(req) as resp:
        return json.loads(resp.read().decode("utf-8"))


def _token():
    """GITHUB_TOKEN env var (GitHub Actions) or mounted secret file (Prow)."""
    env_token = os.environ.get("GITHUB_TOKEN")
    if env_token:
        return env_token
    with open(TOKEN_PATH) as f:
        return f.read().strip()


def _job_url():
    """Best-effort link to the current run, on either GitHub Actions or Prow."""
    if os.environ.get("GITHUB_ACTIONS") == "true":
        server = os.environ.get("GITHUB_SERVER_URL")
        repo = os.environ.get("GITHUB_REPOSITORY")
        run_id = os.environ.get("GITHUB_RUN_ID")
        if server and repo and run_id:
            return f"{server}/{repo}/actions/runs/{run_id}"
        return None

    job_name = os.environ.get("JOB_NAME")
    build_id = os.environ.get("BUILD_ID")
    if not job_name or not build_id:
        return None
    return (
        "https://prow.k8s.io/view/gs/kubernetes-ci-logs/logs/"
        f"sigs.k8s.io_agent-sandbox/{job_name}/{build_id}/"
    )


def main():
    token = _token()

    query = f"repo:{REPO} is:issue is:open in:body {MARKER}"
    search_url = f"{API_ROOT}/search/issues?q={urllib.parse.quote(query)}"
    results = _request("GET", search_url, token)

    body_lines = [
        MARKER,
        "### PoC: periodic CI job GitHub issue creation",
        "",
        "Filed automatically by a periodic CI job (Prow or GitHub Actions) "
        "to verify that it can authenticate to GitHub and file/update an "
        "issue. Safe to close.",
    ]
    job_url = _job_url()
    if job_url:
        body_lines += ["", f"[Latest run]({job_url})"]
    body = "\n".join(body_lines)

    if results.get("total_count", 0) > 0:
        issue_number = results["items"][0]["number"]
        comment_url = f"{API_ROOT}/repos/{REPO}/issues/{issue_number}/comments"
        _request("POST", comment_url, token, {"body": body})
    else:
        issues_url = f"{API_ROOT}/repos/{REPO}/issues"
        _request(
            "POST",
            issues_url,
            token,
            {"title": "[PoC] periodic CI job GitHub issue creation", "body": body},
        )
    return 0


if __name__ == "__main__":
    sys.exit(main())
